{
  "pid_start": {
    "contract": "HELLO pid_start and ppid_start are opaque strings compared for equality only; each OS has one fixed format, and an empty string means the start time could not be measured.",
    "windows": {
      "format": "decimal u64 FILETIME of the process creation time (100 ns ticks since 1601-01-01 UTC), from GetProcessTimes",
      "example": "133750000000000000",
      "min": 120000000000000000,
      "max": 200000000000000000
    },
    "linux": {
      "format": "field 22 of /proc/<pid>/stat (start time in clock ticks since boot), decimal, counted after the last ')' because the command name may contain spaces and parentheses",
      "stat_line": "4242 (kory (mcp) daemon) S 1 4242 4242 0 -1 4194560 100 0 0 0 1 2 0 0 20 0 3 0 987654 12345678 1234 18446744073709551615 0 0 0 0 0 0 0 0 0",
      "expected": "987654"
    },
    "other_unix": {
      "format": "trimmed output of `ps -o lstart= -p <pid>`",
      "example": "Sat Nov  8 14:46:14 2026"
    }
  },
  "frame": {
    "length_prefix": "u32 little-endian, counts the type byte plus the payload",
    "max_payload_bytes": 16777216,
    "types": {
      "CHALLENGE": 1,
      "AUTH": 2,
      "AUTH_OK": 3,
      "HELLO": 4,
      "WELCOME": 5,
      "MCP": 16,
      "TICKET": 17,
      "BYE": 18,
      "PING": 19,
      "PONG": 20,
      "ERROR": 21,
      "CONTROL": 32
    },
    "example": {
      "type": 16,
      "payload": "{\"jsonrpc\":\"2.0\"}",
      "bytes_hex": "12000000107b226a736f6e727063223a22322e30227d"
    }
  },
