{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/desk-backchannel-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/approval-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/approval-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-peers__roadmap_add",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap-guard-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude-peers__roadmap_update",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap-guard-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude-peers__roadmap_append_context",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/roadmap-guard-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
