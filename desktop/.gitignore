node_modules/
out/
dist/
# The desktop package is npm-managed (package-lock.json); a stray bun install
# (e.g. for typechecking) must not add a second lockfile.
bun.lock
*.log
.DS_Store
# App-written runtime state when dogfooding the app from this dir.
.claude/
# Local, machine-specific node-gyp pin (e.g. msvs_version on Windows). Not shared.
.npmrc
# Built hook bundle (generated by `npm run build:hook` from hooks/desk-backchannel-hook.ts).
# The plugin's static files (.claude-plugin/plugin.json, hooks/hooks.json) stay tracked.
deck-plugin/hooks/desk-backchannel-hook.mjs
deck-plugin/hooks/approval-hook.mjs
deck-plugin/hooks/roadmap-guard-hook.mjs
deck-plugin/hooks/desk-statusline.mjs
# Built TTSR hook (generated by `npm run build:hook` from hooks/ttsr-hook.ts).
deck-plugin/hooks/ttsr-hook.mjs
deck-plugin/hooks/kory-telemetry.mjs
deck-plugin/tsconfig.json
# Built CLI bundles (generated by `npm run build:cli` from cli/*.ts) -- the
# whole dir, same rationale as deck-plugin/mcp/ below.
deck-plugin/bin/
# Built MCP bundles (generated by `npm run build:mcp` from mcp/*.ts and
# ../server-deck.ts) -- the whole dir, so a future build:mcp target added here
# never needs a matching .gitignore edit.
deck-plugin/mcp/
# Built design-mode client (generated by `npm run build:design` from design-client/deck-design.ts).
deck-plugin/design/deck-design.js
