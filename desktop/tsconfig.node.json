{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "types": [
      "node",
      "electron-vite/node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "../shared/approval.ts",
    "../shared/text.ts",
    "../shared/types.ts",
    "../shared/project-key.ts",
    "../shared/approval-client.ts",
    "shared/permission-lease.ts",
    "../shared/peer-cache.ts",
    "../shared/logger.ts",
    "../shared/log-redact.ts",
    "hooks/**/*.ts",
    "mcp/**/*.ts",
    "scripts/win-verify/**/*.ts",
    "cli/**/*.ts"
  ]
}
